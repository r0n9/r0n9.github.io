# GitHub 个人访问令牌 (必须具备当前仓库的 Contents 写入权限)
# 生成路径: GitHub Settings -> Developer settings -> Personal access tokens (Tokens classic 或 Fine-grained)
GITHUB_TOKEN=1313

# Web 发布台管理口令 (用于浏览器端输入解锁发布权限)
ADMIN_SECRET=change_this_to_your_secure_password

# 目标仓库与分支 (默认 r0n9/r0n9.github.io 与 master)
GITHUB_REPO=r0n9/r0n9.github.io
GITHUB_BRANCH=master

# 默认文章与动态作者署名
AUTHOR=R0n9

# 公开博客地址（用于互动通知和后台跳转）
SITE_URL=https://r0n9.github.io

# 服务监听端口
PORT=13133
