{{- $index := slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) (ne .Section `moments`) }}
    {{- $date := "" }}
    {{- if not .Date.IsZero }}
      {{- $date = .Date.Format "2006年1月2日" }}
    {{- end }}
    {{- $summary := .Summary | plainify | htmlUnescape }}
    {{- $desc := .Description | default $summary | plainify | htmlUnescape }}
    {{- $content := .Plain | htmlUnescape }}
    {{- $index = $index | append (dict "title" .Title "content" $content "permalink" .Permalink "date" $date "description" $desc) -}}
    {{- end }}
{{- end -}}
{{- $index | jsonify -}}
